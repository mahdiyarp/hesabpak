FLASK_ENV=production
PORT=8000
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this
ADMIN_EMAIL=
DATA_DIR=data
URL_PREFIX=

# Dedicated demo instance: demo data is reset on demo logout.
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Stable key used to encrypt AI API credentials stored in SQLite.
CREDENTIAL_ENCRYPTION_KEY=
INCLUDE_UPLOADS_IN_BACKUP=true

# Optional backup email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT=20
BACKUP_EMAIL_TO=

# Web hardening
SESSION_COOKIE_SECURE=true
MAX_UPLOAD_MB=15
ASSISTANT_MAX_IMAGE_MB=2

# Public origin used when generating shareable absolute demo links (e.g. https://demo.example.com)
PUBLIC_BASE_URL=
