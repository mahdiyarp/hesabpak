PORT=8000
SECRET_KEY=change-this-to-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this
ADMIN_EMAIL=
DATA_DIR=data
URL_PREFIX=

# Optional backup email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT=20
BACKUP_EMAIL_TO=

# Web hardening
SESSION_COOKIE_SECURE=true
MAX_UPLOAD_MB=15

# Stable key used to encrypt AI API credentials stored in SQLite.
# Preserve this value when migrating/restoring the application database.
CREDENTIAL_ENCRYPTION_KEY=
